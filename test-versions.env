# ---- hererocks 0.25.1 (lua target): installs Lua, LuaJIT and LuaRocks for
# each Lua version RunCi tests. Installed from this wheel into a virtual
# environment of the pinned Python, so RunCi finds `hererocks` and does not
# install it with pip/pipx.
: "${TEST_HEREROCKS_VERSION:=0.25.1}"
: "${TEST_FILE_PIP_HEREROCKS_URL:=https://files.pythonhosted.org/packages/14/a8/7903eac744562b403b608c4c6fa667e34631ac0787e13e1b1a33ae956366/hererocks-0.25.1-py3-none-any.whl}"
: "${TEST_FILE_PIP_HEREROCKS_SHA256:=43d5e9283588f83aeb703d6d9bc74249d2fa75126638699ca5fdfd1782f47909}"
