: "${TEST_FILE_PHP_MAC_X64_SHA256:=bd1c20f355e73a9f807b24ba62fd98f3a57bc08d063ebb3aa6393909e01ce89e}"
: "${TEST_FILE_PHP_LINUX_ARM64_URL:=$_php/php-8.4.23-cli-linux-aarch64.tar.gz}"
: "${TEST_FILE_PHP_LINUX_ARM64_SHA256:=0978d89157292bcc9268a34a73a4d5d2793f8dff1403b5138a94d2af6b7a09b0}"
: "${TEST_FILE_PHP_LINUX_X64_URL:=$_php/php-8.4.23-cli-linux-x86_64.tar.gz}"
: "${TEST_FILE_PHP_LINUX_X64_SHA256:=1aeed5bc7967977ca5b1da7163acd91bf9ba3ac56037045d4e91ee2ff2712bb7}"
: "${TEST_FILE_PHP_WINDOWS_X64_URL:=https://windows.php.net/downloads/releases/php-8.4.27-1-nts-Win32-vs17-x64.zip}"
