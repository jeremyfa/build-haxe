# Pinned versions of everything the Haxe test suites need (test-haxe.sh).
# Sourced after the profile: values set in the environment or in a profile
# win over this file (`: "${VAR:=...}"`).
#
# Every file and every git commit here is also an asset of the release
# test-deps of the dependency mirror (scripts/mirror-deps.sh).
#
# Git repositories that RunCi clones or installs with haxelib:
#   TEST_GIT_<N>_REPO     repository URL (as RunCi writes it, without .git)
#   TEST_GIT_<N>_COMMIT   pinned commit
#   TEST_GIT_<N>_SHA256   sha256 of the tar of that commit
#                         (`git archive --prefix=<name>-<commit>/`, uncompressed)
#   TEST_GIT_<N>_HAXELIB  optional: haxelib library name, installed with
#                         `haxelib dev` before the tests
#   TEST_GIT_<N>_HAXELIB_DIR optional: folder of that library in the
#                         repository (default: its root)
#   TEST_GIT_<N>_BRANCHES optional: branches of the local mirror, all at the
#                         pinned commit (default: master main)
# RunCi's own `git clone` and `haxelib git` calls are redirected to local
# mirrors of these commits (scripts/test/git-mirrors.sh).
#
# Files (toolchains):
#   TEST_FILE_<KEY>_URL, TEST_FILE_<KEY>_SHA256, optional TEST_FILE_<KEY>_NAME
#   (asset name in the mirror, default: basename of the URL)
#   <KEY> ends with the platform: _MAC_ARM64, _MAC_X64, _LINUX_ARM64,
#   _LINUX_X64, _WINDOWS_X64.

# Linux test image (docker/linux-test.Dockerfile), pinned by digest
: "${TEST_IMAGE:=ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11}"

TEST_GIT_DEPS="UTEST HAXESERVER TINK_CORE HXCORO HXJAVA HXNODEJS FORMAT JAVA_LIB_TESTS HXCPP HASHLINK HXCS"

: "${TEST_GIT_UTEST_REPO:=https://github.com/haxe-utest/utest}"
: "${TEST_GIT_UTEST_COMMIT:=a055e05e2e872ae12a32b53d0200612345059c38}"
: "${TEST_GIT_UTEST_SHA256:=4c442ac566c329a9a2ca27d757fd261a25e8ae4e43e7c25da17a9ef2e8c3b6d1}"
: "${TEST_GIT_UTEST_HAXELIB:=utest}"

: "${TEST_GIT_HAXESERVER_REPO:=https://github.com/Simn/haxeserver}"
: "${TEST_GIT_HAXESERVER_COMMIT:=fad3af2a59a5b00e4abb3f0b4734b779dba90ba5}"
: "${TEST_GIT_HAXESERVER_SHA256:=3228f332522036b87d6bb64c27f08e288b98cc4f782e4cd9e26aae811c3b6ee5}"
: "${TEST_GIT_HAXESERVER_HAXELIB:=haxeserver}"

# Cloned by the macro target ("party" tests).
: "${TEST_GIT_TINK_CORE_REPO:=https://github.com/haxetink/tink_core}"
: "${TEST_GIT_TINK_CORE_COMMIT:=95c0d300494307278fdfb4e02729679c437c2e24}"
: "${TEST_GIT_TINK_CORE_SHA256:=6aa60a22bb3680c28b475ff9ff45b0f119a893b6b3a15b8df0e91d9fc62b939c}"

# Cloned by the macro target of the development branch (`-b master`).
: "${TEST_GIT_HXCORO_REPO:=https://github.com/HaxeFoundation/hxcoro}"
: "${TEST_GIT_HXCORO_COMMIT:=7c0efd958237043f02b8cb621b85a0a0bb2e65a8}"
: "${TEST_GIT_HXCORO_SHA256:=09a0a013abf81ef82f92d1212d8fdf814881e4c50905f273b62cb2f576b3d47c}"
: "${TEST_GIT_HXCORO_HAXELIB:=hxcoro}"

# Java support library (java target on 4.3, jvm, and the js server tests).
: "${TEST_GIT_HXJAVA_REPO:=https://github.com/HaxeFoundation/hxjava}"
: "${TEST_GIT_HXJAVA_COMMIT:=f8c7dc6c56f4bf8f5912b4844a1b55ab094ee0cf}"
: "${TEST_GIT_HXJAVA_SHA256:=8d02a325f189514d326af8a05dfa38e5ad163a4e588a0c8b87da9e6d4973cb25}"
: "${TEST_GIT_HXJAVA_HAXELIB:=hxjava}"

# Node.js externs (js target).
: "${TEST_GIT_HXNODEJS_REPO:=https://github.com/HaxeFoundation/hxnodejs}"
: "${TEST_GIT_HXNODEJS_COMMIT:=f88685a70b2e4f03dbe0a824ce90ea8b56b27753}"
: "${TEST_GIT_HXNODEJS_SHA256:=700bcccc14d53b0c9c152b60c9ef93f6ec535cd84d786e10953c01c8841c4623}"
: "${TEST_GIT_HXNODEJS_HAXELIB:=hxnodejs}"

# format, branch jvm (installed by the jvm target).
: "${TEST_GIT_FORMAT_REPO:=https://github.com/HaxeFoundation/format}"
: "${TEST_GIT_FORMAT_COMMIT:=cf87631b54a79ee3fcc09868b4bda8063c8c034d}"
: "${TEST_GIT_FORMAT_SHA256:=7457c8b6cf1bd6c7a617a64507162aefe697af933daee377713a079386f5d2ac}"
: "${TEST_GIT_FORMAT_HAXELIB:=format}"
