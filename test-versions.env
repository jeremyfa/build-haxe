# ---- npm packages of the js target: deasync and its dependencies, installed
# from these files into the test copy (scripts/test/run-target hooks), so npm
# never resolves anything from the registry.
TEST_NPM_PACKAGES="DEASYNC BINDINGS FILE_URI_TO_PATH NODE_ADDON_API"
: "${TEST_FILE_NPM_DEASYNC_URL:=https://registry.npmjs.org/deasync/-/deasync-0.1.32.tgz}"
: "${TEST_FILE_NPM_DEASYNC_SHA256:=1beaf8fc3e5adfd23db851e4b1cf760b1d870b74b5102d65facc1e6fd807a608}"
: "${TEST_FILE_NPM_BINDINGS_URL:=https://registry.npmjs.org/bindings/-/bindings-1.5.0.tgz}"
: "${TEST_FILE_NPM_BINDINGS_SHA256:=d77781178c5bd89a91b1f6c5556acd511b1b5927eb13e2ad8189cac29eeb0907}"
: "${TEST_FILE_NPM_FILE_URI_TO_PATH_URL:=https://registry.npmjs.org/file-uri-to-path/-/file-uri-to-path-1.0.0.tgz}"
: "${TEST_FILE_NPM_FILE_URI_TO_PATH_SHA256:=5440cdf67e75ab96f36a6be63c1d4c3d54255b1d0970273710fecfebfab06fb3}"
: "${TEST_FILE_NPM_NODE_ADDON_API_URL:=https://registry.npmjs.org/node-addon-api/-/node-addon-api-1.7.2.tgz}"
: "${TEST_FILE_NPM_NODE_ADDON_API_SHA256:=ff68fd3bf9dbe1823217898a6f82a7f5cc601a0a24263787fba763695474dbd7}"

# ---- PHP 8.4 with mbstring, sqlite3, pdo_sqlite and sockets: static builds
# of static-php-cli ("common" extension set) on macOS and Linux, the official
# build on Windows (with ext/, loaded by tests/PHP.ini).
: "${TEST_PHP_VERSION:=8.4}"
_php=https://dl.static-php.dev/static-php-cli/common
: "${TEST_FILE_PHP_MAC_ARM64_URL:=$_php/php-8.4.23-cli-macos-aarch64.tar.gz}"
: "${TEST_FILE_PHP_MAC_ARM64_SHA256:=bba286e442796dbd420d778a016e2817b31d5036d11b3ba316d19a60de912cdc}"
