# Cloned by the java target of 4.3.
: "${TEST_GIT_JAVA_LIB_TESTS_REPO:=https://github.com/waneck/java-lib-tests}"
: "${TEST_GIT_JAVA_LIB_TESTS_COMMIT:=79e249f15f9e34f965e033d5b2c4e9b66fd95844}"
: "${TEST_GIT_JAVA_LIB_TESTS_SHA256:=5720ad01b68bdd09160ad60b8daf96d8e3764939f49d2ab6fac089513df4a7f3}"

# hxcpp (cpp and cppia targets). scripts/test/haxelibs.sh builds its tools
# (hxcpp.n) and, on the development branch, the cppia host, which RunCi
# skips when hxcpp is already installed.
: "${TEST_GIT_HXCPP_REPO:=https://github.com/HaxeFoundation/hxcpp}"
: "${TEST_GIT_HXCPP_COMMIT:=a04a2c4c15b54162a91d87923a3e3ef44aca72d0}"
: "${TEST_GIT_HXCPP_SHA256:=7f4b697665cdf93e76ef5af2930a73a96f6a693c1636be1b0feb3da3feb51cd5}"
: "${TEST_GIT_HXCPP_HAXELIB:=hxcpp}"

# HashLink (hl target), built by scripts/test/tool-hashlink.sh. Its haxelib
# library lives in other/haxelib.
: "${TEST_GIT_HASHLINK_REPO:=https://github.com/HaxeFoundation/hashlink}"
: "${TEST_GIT_HASHLINK_COMMIT:=708611fedfc2de716b7d3345a5d1f438eef80504}"
: "${TEST_GIT_HASHLINK_SHA256:=92b956d46d7b845efa9d957385e6faf3544141f09524a382431b7fb4965b1a8a}"
: "${TEST_GIT_HASHLINK_HAXELIB:=hashlink}"
: "${TEST_GIT_HASHLINK_HAXELIB_DIR:=other/haxelib}"

# C# support library (cs target of 4.3).
: "${TEST_GIT_HXCS_REPO:=https://github.com/HaxeFoundation/hxcs}"
: "${TEST_GIT_HXCS_COMMIT:=b9b2d6e02d05d09c5ff95876011a05c2d34edbb0}"
: "${TEST_GIT_HXCS_SHA256:=1223e2abcdbe7f04b5588f88cfe6db7dfa59864d15d9103c1fbac18b9a894d89}"
: "${TEST_GIT_HXCS_HAXELIB:=hxcs}"

