# Neko sources (built by scripts/build-neko.sh with static dependencies; neko
# pins its own dependencies by sha256 in its CMakeLists). Each profile picks
# one of them with NEKO_SOURCE. A source <S> is described by:
#   NEKO_<S>_REPO    GitHub repository (default: HaxeFoundation/neko)
#   NEKO_<S>_COMMIT  commit to build
#   NEKO_<S>_SHA256  sha256 of the source archive of that commit
#   NEKO_<S>_URL     optional: archive URL (default: GitHub's archive of the
#                    commit in NEKO_<S>_REPO)
#   NEKO_<S>_NAME    optional: folder name of the build (default: <s>-<commit>)
# Values set in the environment win over this file, and a profile can define
# its own source (a fork with patches merged, for instance). See README.md.
# Release 2.4.1 (tag v2-4-1)
: "${NEKO_RELEASE_REPO:=https://github.com/HaxeFoundation/neko}"
: "${NEKO_RELEASE_COMMIT:=e2fa58bde7e9ab4be0214f3e23b331da4d348c56}"
: "${NEKO_RELEASE_SHA256:=0d40124255945e76ab1825b48bd5407f34f767800649dbde33f7aefbe2aecc43}"
# master: Haxe 5 needs primitives added after 2.4.1 (std@lock_create...)
: "${NEKO_MASTER_REPO:=https://github.com/HaxeFoundation/neko}"
: "${NEKO_MASTER_COMMIT:=802b163a30d75844424cf034cc2a20a88c7215bf}"
: "${NEKO_MASTER_SHA256:=86408bf329bc786ec1fcd0c9035c8f94fd624375594ec41ac6d22685b733c9fe}"

# Container images, pinned by multi-arch index digest
ALPINE_IMAGE=alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
# glibc image (neko, haxelib). Its glibc is the minimum glibc of haxelib and
# neko: Debian 11, glibc 2.31. Debian 11 is out of support: its packages come
# from a fixed snapshot.debian.org date.
GLIBC_IMAGE=debian:bullseye-slim@sha256:e5b6442dd2e9684cf5e87d8338b5968f3b348636fc0be6d7850a381e3731a2bd
GLIBC_SNAPSHOT=20260825T000000Z

# Default Haxe source
DEFAULT_HAXE_REPO=https://github.com/HaxeFoundation/haxe.git
DEFAULT_HAXE_BRANCH=development
