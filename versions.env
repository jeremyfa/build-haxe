OPAM_SHA256_arm64_macos=b35efa25668996f8df807b57b571aaccb5a6f78395cbefd32a3860df6d3eef39
OPAM_SHA256_x86_64_macos=9cf6031b599c862f0a0886f2b0354bb80cd8cad21a349c7894e55fac54209c83
OPAM_SHA256_x86_64_linux=324e78e3f33efeba279aacf9f9610cfec7b2df7d7e0e1640f75f09de85f96cc9
OPAM_SHA256_arm64_linux=c363d070b1771b6830c6806eb9fd5ff1a54d0fe97bf389cd2dff20b6d203b2ad

# opam-repository snapshot used to resolve and install the OCaml dependencies.
# Changing it requires regenerating the locks (scripts/update-locks.sh).
OPAM_REPO_COMMIT=8a77e5840dbfd5af7fae0320e3b21a7df6b9fd2f

# C libraries, built from source and linked statically
