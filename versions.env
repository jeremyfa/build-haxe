# Container images, pinned by multi-arch index digest
ALPINE_IMAGE=alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
# glibc build images (haxelib). Their glibc is the minimum glibc of haxelib,
# chosen as the oldest one accepted by the neko release of each arch.
GLIBC_IMAGE_x64=debian:bullseye-slim@sha256:e5b6442dd2e9684cf5e87d8338b5968f3b348636fc0be6d7850a381e3731a2bd
# Debian 11 is out of support: its packages come from this snapshot.debian.org date
GLIBC_SNAPSHOT_x64=20260825T000000Z
GLIBC_IMAGE_arm64=ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11
GLIBC_SNAPSHOT_arm64=

# Default Haxe source
DEFAULT_HAXE_REPO=https://github.com/HaxeFoundation/haxe.git
DEFAULT_HAXE_BRANCH=development
