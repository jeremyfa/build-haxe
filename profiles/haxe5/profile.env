# Profile for the development branch (Haxe 5).
# Values already set in the environment take precedence.

: "${OCAML_VERSION:=5.3.0}"
: "${MBEDTLS_SERIES:=3}"

# opam packages pinned before resolving the dependencies (name.version)
OPAM_PINS=""

# How the compiler is built (see scripts/build-core.sh)
PROFILE_BUILD_STYLE=dune-release

# macOS deployment targets for the haxe binary
: "${MACOS_MIN_arm64:=11.0}"
: "${MACOS_MIN_x86_64:=10.13}"

# Default test targets for test-haxe.sh. The neko tests of Haxe 5 need thread
# primitives (std@lock_create...) that no neko release has yet (2.4.1 is
# from 2025-04): they only pass with a neko built from the master branch.
: "${DEFAULT_TEST_TARGETS:=macro}"
