# Profile for the development branch (Haxe 5).
# Values already set in the environment take precedence.

: "${OCAML_VERSION:=5.3.0}"
: "${MBEDTLS_SERIES:=3}"

# opam packages pinned before resolving the dependencies (name.version)
: "${OPAM_PINS=}"

# How the compiler is built (see scripts/build-core.sh)
: "${PROFILE_BUILD_STYLE:=dune-release}"

# macOS deployment targets (haxe, neko and haxelib)
: "${MACOS_MIN_arm64:=11.0}"
: "${MACOS_MIN_x86_64:=10.13}"

# neko built from master: the neko output of Haxe 5 uses primitives that no
# neko release has yet (2.4.1 is from 2025-04).
: "${NEKO_SOURCE:=MASTER}"

# Default test targets for test-haxe.sh
: "${DEFAULT_TEST_TARGETS:=macro,neko}"
