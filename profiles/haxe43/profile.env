# Profile for the 4.3_bugfix branch (Haxe 4.3.x).
# Values already set in the environment take precedence.
# OCaml 5.1.1 like the official 4.3 CI: luv 0.5.13 needs ctypes 0.21.1
# (see OPAM_PINS), which requires OCaml < 5.2.

: "${OCAML_VERSION:=5.1.1}"
: "${MBEDTLS_SERIES:=2}"

# opam packages pinned before resolving the dependencies (name.version).
# luv 0.5.13 does not compile with ctypes >= 0.22 and a recent clang
# (incompatible function pointer types), the official 4.3 CI pins it too.
: "${OPAM_PINS=ctypes.0.21.1}"

# How the compiler is built (see scripts/build-core.sh)
: "${PROFILE_BUILD_STYLE:=dune-workspace-dev}"

# macOS deployment targets (haxe, neko and haxelib)
: "${MACOS_MIN_arm64:=11.0}"
: "${MACOS_MIN_x86_64:=10.13}"

# neko built from master, like Haxe 5: Haxe 4.3.7 passes the same macro and
# neko suites with it as with the 2.4.1 release (2026-11-03, mac universal,
# Linux arm64 and x64). NEKO_SOURCE=RELEASE goes back to 2.4.1.
: "${NEKO_SOURCE:=MASTER}"

# Default test targets for test-haxe.sh
: "${DEFAULT_TEST_TARGETS:=macro,neko}"

# Test dependencies of the 4.3 branch (see test-versions.env): the utest
# commit RunCi 4.3 asks for, and tink_core as it was when 4.3.7 was released.
: "${TEST_GIT_UTEST_COMMIT:=a94f8812e8786f2b5fec52ce9f26927591d26327}"
: "${TEST_GIT_UTEST_SHA256:=ab9c171a9b96b0ca2cf2306bec9f2780c80a4b99d62e2f00308c77c38b3458fb}"
: "${TEST_GIT_TINK_CORE_COMMIT:=323f80d2ae63036e5b324dc68775f79e98bde396}"
: "${TEST_GIT_TINK_CORE_SHA256:=35ee86d26abb7ef13f933d3a1f389bfe4a82c9c566f3fae0337b08838bb99165}"
# hxcpp as it was when 4.3.7 was released. The 4.3 tests build their own
# cppia host.
: "${TEST_BUILD_CPPIA_HOST:=0}"
: "${TEST_GIT_HXCPP_COMMIT:=86d4b1a07ddadf162a0c48487f1e1b17d7bbcd64}"
: "${TEST_GIT_HXCPP_SHA256:=8a56897e5c2a2fc8598f16e8ab35e10efba0ce24a768c88ce3eb22ee3f69d9e1}"
# JDK 11 (Temurin 11.0.32.1+1): the Java class reader of Haxe 4.3 cannot read
# the class files of newer JDKs ("Class reader failed: Invalid constant index
# 0"), and the official 4.3 CI ran with the Java 11 of its runners.
: "${TEST_JDK_VERSION:=11.0.32.1+1}"
_jdk=https://github.com/adoptium/temurin11-binaries/releases/download/jdk-11.0.32.1%2B1
: "${TEST_FILE_JDK_MAC_ARM64_URL:=$_jdk/OpenJDK11U-jdk_aarch64_mac_hotspot_11.0.32.1_1.tar.gz}"
: "${TEST_FILE_JDK_MAC_ARM64_SHA256:=c487a1c3a56588b3a32d0d07cdd526bf3d401c4b8422be772ca178bfcd647f3f}"
: "${TEST_FILE_JDK_MAC_X64_URL:=$_jdk/OpenJDK11U-jdk_x64_mac_hotspot_11.0.32.1_1.tar.gz}"
: "${TEST_FILE_JDK_MAC_X64_SHA256:=03de26f0d11ec3e6365e0352d9fcfaff447be35a2b2f36ee1ffb6063980343f5}"
: "${TEST_FILE_JDK_LINUX_ARM64_URL:=$_jdk/OpenJDK11U-jdk_aarch64_linux_hotspot_11.0.32.1_1.tar.gz}"
: "${TEST_FILE_JDK_LINUX_ARM64_SHA256:=f27033e6f7523c1b0b2565a78e9c0e0abe5596a854ce00ca04ec1b06ece7a935}"
: "${TEST_FILE_JDK_LINUX_X64_URL:=$_jdk/OpenJDK11U-jdk_x64_linux_hotspot_11.0.32.1_1.tar.gz}"
: "${TEST_FILE_JDK_LINUX_X64_SHA256:=5c3f68887c325d36d852ba534303e1f5f1f5cae7d6cc1e951d73e0d8e98a058d}"
: "${TEST_FILE_JDK_WINDOWS_X64_URL:=$_jdk/OpenJDK11U-jdk_x64_windows_hotspot_11.0.32.1_1.zip}"
: "${TEST_FILE_JDK_WINDOWS_X64_SHA256:=d5008f02174c1ad21c10407cbf104815cb390ec4c263d53946e8d0507d7a77f9}"
unset _jdk

# HashLink as it was when 4.3.7 was released (HL 1.15, the 4.3 tests target
# hl-ver 1.13).
: "${TEST_GIT_HASHLINK_COMMIT:=0f3bc3908f63e244588f1c0df09eef28fcfb148d}"
: "${TEST_GIT_HASHLINK_SHA256:=154423e57aa77c7ef19f37b7ad18f1593813dbf725b51f64327c86a7ad897139}"

# Full test suite (./test-haxe.sh <target> all), as on the official CI of
# 4.3_bugfix (cpp also runs the cppia tests).
: "${FULL_TEST_TARGETS:=macro neko js hl cpp java jvm cs python php lua}"
# Not on the official linux-arm64 job: hl (no VM on arm64 in HashLink 1.x),
# cs and java.
: "${TEST_SKIP_LINUX_ARM64:=hl cs java}"
# macOS: lua is not on the official mac job; hl only ran on Intel Macs (the
# HashLink 1.x VM is x86_64 only, and its libraries came from Homebrew).
: "${TEST_SKIP_MAC:=hl lua}"
# Windows: lua is not on the official job (haxe#10919); hl is not set up by
# build-haxe on Windows yet.
: "${TEST_SKIP_WINDOWS:=hl lua}"

# Allowed to fail (status allowed-fail, the job passes):
# - cs on macOS: misc/cs/csTwoLibs/compile-3 does not compile with the mono
#   6.14 of Homebrew (53 C# errors such as "global::Array could not be found");
#   every other cs test passes, and all of them pass with the mono 6.8 of the
#   Linux image.
: "${TEST_ALLOW_FAIL_MAC_ARM64:=cs}"
# - js on Windows: the server tests fail (`node test.js` exits with an
#   unhandled ECONNRESET). php on Windows hangs in the unit tests and is
#   stopped by TEST_TIMEOUT. Neither is investigated yet.
: "${TEST_ALLOW_FAIL_WINDOWS_X64:=js php}"

# Windows: the camlp5 of 4.3 checks two perl modules (conf-perl-*), which opam
# does not install on Windows. setup-switch.sh installs IPC::System::Simple
# from Cygwin and String::ShellQuote (no Cygwin package) from its pinned CPAN
# archive (versions.env).
: "${CYGWIN_PACKAGES:=perl-IPC-System-Simple}"
: "${WINDOWS_PERL_MODULES:=STRING_SHELLQUOTE}"
